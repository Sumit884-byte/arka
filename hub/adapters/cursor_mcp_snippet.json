{
  "description": "Point cursor at Arka hub MCP config",
  "hub_mcp": "/Users/sumitmishra/dev/arka/hub/mcp.json",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },
    "arka": {
      "command": "/Users/sumitmishra/dev/arka/venv-arka/bin/arka",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "spline": {
      "command": "/Users/sumitmishra/dev/arka/venv-arka/bin/spline-mcp",
      "env": {
        "SPLINE_API_KEY": "${env:SPLINE_API_KEY}",
        "SPLINE_WORKSPACE_ID": "${env:SPLINE_WORKSPACE_ID}"
      }
    },
    "datahub": {
      "command": "uvx",
      "args": [
        "mcp-server-datahub"
      ],
      "env": {
        "DATAHUB_GMS_URL": "${env:DATAHUB_GMS_URL}",
        "DATAHUB_GMS_TOKEN": "${env:DATAHUB_GMS_TOKEN}",
        "TOOLS_IS_MUTATION_ENABLED": "true",
        "TOOLS_IS_USER_ENABLED": "true"
      }
    }
  },
  "install_hint": "Merge mcpServers into /Users/sumitmishra/.cursor/mcp.json or symlink to /Users/sumitmishra/dev/arka/hub/mcp.json"
}
