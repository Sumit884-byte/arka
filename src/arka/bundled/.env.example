# Arka environment reference (canonical)
#
# Copy to ~/.config/arka/.env (macOS/Linux) or %APPDATA%\arka\.env (Windows).
# Dev checkout: arka/.env fills unset vars only (see README "How defaults work").
#
# Conventions:
#   - Short names in .env (no ARKA_ prefix). Legacy ARKA_* keys normalize on load
#     (ARKA_ROUTE_MODE → ROUTE_MODE). Exception: ARKA_HOME → INSTALL_HOME.
#   - Placeholders like your_key_here or changeme are ignored (treated as unset).
#   - Uncomment optional lines to override built-in defaults.
# Quick starter (fewer vars): repo-root .env.example


# =============================================================================
# Terminal output styling
# =============================================================================
# ARKA_OUTPUT_STYLE=auto              # auto | plain | rich — layout colors/tables (default auto)
# ARKA_OUTPUT_EMOJI=0                 # 1 = ✓/✗/→ prefixes instead of [ok]/[error]
# ARKA_MARKDOWN_STYLE=1               # style markdown bodies inside result boxes
# ARKA_MARKDOWN_BACKEND=auto          # auto | rich | glow | ansi | plain
# ARKA_OUTPUT_VERIFY=0                  # 1 = judge-model quality check on text answers
# ARKA_OUTPUT_VERIFY_BLOCK=0            # 1 = wait for verify before showing footer
# ARKA_OUTPUT_VERIFY_TIMEOUT_MS=5000    # max wait for non-blocking verify
# ARKA_OUTPUT_SLOW_MS=8000              # flag responses slower than this (ms)
# ARKA_OUTPUT_SHOW_VERIFY=1             # show quality line in answer footer
# ai-skill-model judge gemini/gemini-2.5-flash   # override judge model profile

# =============================================================================
# Paths & install layout
# =============================================================================
# Override where Arka reads config, cache, and bundled scripts.
# INSTALL_HOME=~/dev/arka              # package / script root (legacy: ARKA_HOME)
# CONFIG_DIR=~/.config/arka            # user config (legacy: ARKA_CONFIG_DIR)
# ARKA_CONFIG_DIR=~/.config/arka        # same as CONFIG_DIR — single config root
# ARKA_CONFIG_BACKUP_ON_UNIFY=1         # auto-backup before agent_hub sync --unify
# CACHE_DIR=~/.cache/arka              # logs, models, temp (legacy: ARKA_CACHE_DIR)


# =============================================================================
# LLM — API keys (set any you use; orchestrator auto-detects configured keys)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=                    # Kimi (alias: KIMI_API_KEY)
# ZAI_API_KEY=                         # Z.AI GLM (aliases: ZHIPUAI_API_KEY, GLM_API_KEY)
# MINIMAX_API_KEY=
# VENICE_API_KEY=
# OPENROUTER_API_KEY=
# RAILWAY_TOKEN=                         # optional backend deploy token
# VERCEL_TOKEN=                          # optional frontend deploy token
# GH_TOKEN=                              # optional GitHub CLI/API token
# SLACK_BOT_TOKEN=                       # optional Slack notifications
# HF_TOKEN=                              # optional Hugging Face inference
# MISTRAL_API_KEY=                       # optional Mistral models
# COHERE_API_KEY=                        # optional Cohere models
# TOGETHER_API_KEY=                      # optional Together models
# NOTION_TOKEN=                           # optional Notion workspace access
# JIRA_API_TOKEN=                         # optional Jira API access
# TEAMS_WEBHOOK_URL=                      # optional Microsoft Teams notifications
# SUPABASE_ACCESS_TOKEN=                  # optional Supabase CLI/API access
# FIREBASE_TOKEN=                         # optional Firebase CLI access
# STRIPE_SECRET_KEY=                      # optional Stripe server integration
# NETLIFY_AUTH_TOKEN=                     # optional Netlify deployment
# RENDER_API_KEY=                         # optional Render deployment
# FLY_API_TOKEN=                          # optional Fly.io deployment
# DOCKERHUB_TOKEN=                        # optional container publishing
# NPM_TOKEN=                              # optional npm publishing
# PYPI_TOKEN=                             # optional PyPI publishing
# DATABASE_URL=                           # optional PostgreSQL connection
# REDIS_URL=                              # optional Redis connection
# MONGODB_URI=                            # optional MongoDB connection
# DD_API_KEY=                              # optional Datadog observability
# NEW_RELIC_LICENSE_KEY=                   # optional New Relic observability
# LANGFUSE_PUBLIC_KEY=                     # optional Langfuse LLM tracing
# LANGCHAIN_API_KEY=                       # optional LangSmith tracing
# WANDB_API_KEY=                           # optional Weights & Biases tracking
# MODAL_TOKEN_ID=                          # optional Modal compute
# E2B_API_KEY=                             # optional E2B sandboxes
# OLLAMA_API_KEY=                          # optional Ollama runtime
# VLLM_API_KEY=                            # optional vLLM runtime
# LMSTUDIO_API_KEY=                        # optional LM Studio runtime
# GROQ_API_KEY=                            # optional Groq inference
# REPLICATE_API_TOKEN=                     # optional Replicate inference
# CLOUDFLARE_API_TOKEN=                    # optional Cloudflare API access
# DIGITALOCEAN_TOKEN=                      # optional DigitalOcean API access
# HCLOUD_TOKEN=                            # optional Hetzner Cloud API access
# RESEND_API_KEY=                          # optional transactional email
# SENDGRID_API_KEY=                        # optional transactional email
# CLERK_SECRET_KEY=                        # optional Clerk authentication
# AUTH0_CLIENT_SECRET=                     # optional Auth0 authentication
# POSTHOG_API_KEY=                         # optional product analytics
# AMPLITUDE_API_KEY=                       # optional product analytics
# LAUNCHDARKLY_API_KEY=                    # optional feature flags
# STATSIG_SERVER_SECRET=                   # optional feature flags
# TELEGRAM_BOT_TOKEN=                      # optional Telegram notifications
# WHATSAPP_ACCESS_TOKEN=                   # optional WhatsApp messaging
# SAKANA_API_KEY=                      # Sakana Fugu orchestrator (alias provider: fugu)
# SAKANA_API_BASE=https://api.sakana.ai/v1
# SAKANA_MODELS=fugu,fugu-ultra
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=
# HF_TOKEN=                            # Hugging Face Inference (aliases: HUGGINGFACE_API_KEY, HF_API_KEY)
# LITELLM_API_KEY=                     # LiteLLM proxy (default http://127.0.0.1:4000/v1)
# LMSTUDIO_API_KEY=                    # LM Studio local (default http://127.0.0.1:1234/v1)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# BEDROCK_API_KEY=                     # optional; or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
# BEDROCK_API_BASE=                    # optional OpenAI-compatible Bedrock gateway URL
# VLLM_API_KEY=EMPTY                   # local vLLM (often no real key)

# Multiple keys per provider (auto-rotate on 429/quota/key errors — default on)
# GEMINI_API_KEYS=key2,key3
# GROQ_API_KEYS=key2,key3
# GEMINI_API_KEY_2=backup_key
# GROQ_API_KEY_2=backup_key
# API_KEY_ROTATION=1                   # set 0 to disable key rotation


# =============================================================================
# LLM — local servers & preference
# =============================================================================
OLLAMA_HOST=127.0.0.1:11434              # localhost only — Ollama has no auth; never bind 0.0.0.0 on untrusted networks
# VLLM_HOST=127.0.0.1:8000
# VLLM_API_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=default
# VLLM_START_CMD=vllm serve --model meta-llama/Llama-3.2-3B-Instruct --port 8000
# VLLM_FALLBACK=1                         # include local vLLM in fallback chain
# Remote vLLM (RunPod, Baseten, custom cloud — OpenAI-compatible /v1/chat/completions)
# VLLM_CLOUD_URL=https://your-endpoint.runpod.net/v1
# VLLM_CLOUD_API_URL=                  # alias for VLLM_CLOUD_URL
# VLLM_CLOUD_API_KEY=your-key
# VLLM_CLOUD_MODEL=meta-llama/Llama-3.2-3B-Instruct
# VLLM_CLOUD_MODELS=model-a,model-b

AI_PREFERRED_PROVIDER=gemini
AI_PREFERRED_MODEL=gemini-2.0-flash
# AI_PREFERRED_PROVIDER=openrouter
# AI_PREFERRED_MODEL=anthropic/claude-3.5-sonnet
# LLM_PROVIDER=                        # alias for AI_PREFERRED_PROVIDER
# LLM_MODEL=                           # alias for AI_PREFERRED_MODEL
#
# Preferred provider CLI:
#   arka provider list
#   arka provider set openrouter
#   arka provider models
#   arka provider set openrouter --model anthropic/claude-3.5-sonnet
# OPENROUTER_LIST=1                    # fetch models from OpenRouter API (default on with key)
# OPENROUTER_FREE_ONLY=1               # use only :free / zero-cost OpenRouter models
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,qwen/qwen3-235b-a22b:free
# LLM_MAX_TOKENS=4096                  # global completion cap (default 4096)
# OPENROUTER_MAX_TOKENS=4096           # OpenRouter-specific cap (default 4096)

# Model lists (merged with live API lists when keys/servers are reachable)
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
# GEMINI_LIST=1                        # fetch generateContent models (default on with key)
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_LIST=1                          # fetch models from Groq API (default on with key)
# OLLAMA_MODELS=minimax-m2.5:cloud,qwen3:8b,llama3.2:1b
# OLLAMA_LIST=1                        # fetch installed models from Ollama (default on when reachable)
# ARKA_OLLAMA_AUTO_PULL=1              # pull missing Ollama models on first LLM use (default on)
# ARKA_OLLAMA_PULL_TIMEOUT=600         # seconds for ollama pull before giving up
#
# Apple Intelligence (on-device, macOS 26+ only — no API key)
# APPLE_FM_ENABLED=1                   # auto-enabled on macOS 26+; set 0 to disable
# APPLE_FM_MODELS=apple-fm-system
# pip install 'arka-agent[apple-fm]'   # or: pip install apple-fm-sdk
# Optional OpenAI-compatible fallback when SDK not installed:
# APPLE_FM_CLI_BASE_URL=http://127.0.0.1:8765/v1
# APPLE_FM_CLI_HOST=127.0.0.1
# APPLE_FM_CLI_PORT=8765
# apple-fm-cli server --host 127.0.0.1 --port 8765
# ANTHROPIC_MODELS=claude-sonnet-4-20250514,claude-3-5-haiku-latest
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
# OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,google/gemini-2.0-flash-001
# MISTRAL_MODELS=mistral-small-latest,mistral-large-latest
# COHERE_MODELS=command-r-plus-08-2024,command-r-08-2024
# TOGETHER_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo
# FIREWORKS_MODELS=accounts/fireworks/models/llama-v3p3-70b-instruct
# PERPLEXITY_MODELS=sonar,sonar-pro
# HF_MODELS=meta-llama/Meta-Llama-3-8B-Instruct

# Failover & server lifecycle (defaults on unless noted)
# LLM_AUTO_FALLBACK=1                  # try next provider/model on quota/key errors
# LLM_AUTO_RETIRED_FIX=1               # auto-skip retired models (410) and update .env
# LLM_FALLBACK=gemini:gemini-2.5-flash,gemini:gemini-2.0-flash,groq:llama-3.3-70b-versatile
# LLM_FALLBACK_CHAIN=                  # alias for LLM_FALLBACK (full override chain)
# LLM_FALLBACK_GUIDANCE=groq:llama-3.3-70b-versatile  # prepend models to auto-built chain
# LLM_FALLBACK_SUMMARIZE=              # per-task full override (also: ROUTE, CHAT, RESEARCH, AGENT, PDF, PREDICTIONS, COMPOSE_VIDEO)
# ROUTE_MODEL=groq/llama-3.1-8b-instant # first model for NL routing (task=route); provider/model or provider:model
# ROUTING_MODEL=groq/llama-3.1-8b-instant             # alias for ROUTE_MODEL
# SKILL_MODEL_CHAT=groq/llama-3.3-70b-versatile       # per-task prepend (SKILL_MODEL_<TASK>; bare model ok)
# SKILL_MODEL_WEB_ANSWER=groq/llama-3.3-70b-versatile # per-skill prepend (SKILL_MODEL_<SKILL>)
# SKILL_MODELS={"chat":"gemini-2.5-flash","web_answer":"groq/llama-3.3-70b-versatile"}  # inline JSON map
# LLM_SKILL_MODELS=~/.config/arka/llm-skill-models.json # JSON file map (see bundled llm-skill-models.example.json)
# LLM_FALLBACK_NOTIFY=1                # stderr when a later provider/model succeeds
# ARKA_ARBITRAGE_ENABLED=0             # background cost arbitrage monitor (arka llm arbitrage start)
# ARKA_ARBITRAGE_INTERVAL=60           # arbitrage poll interval seconds
# ARKA_ARBITRAGE_MIN_SAVINGS=0.15      # minimum relative savings before hot-swap (0-1)
# ARKA_ARBITRAGE_DRAIN=                # last expensive provider:model kept reachable for in-flight requests
# OLLAMA_TUNNEL_PORT=11435             # local OpenAI-compatible proxy port (arka tunnel ollama start)
# OLLAMA_TUNNEL_TOKEN=                 # Bearer token for tunnel proxy (auto-generated on first start)
# OLLAMA_TUNNEL_RPM=60                 # requests per minute per client IP
# LLM_VERBOSE=1                        # log each provider/model attempt
# LLM_AUTO_START_SERVERS=1             # start Ollama/vLLM when needed
# LLM_AUTO_STOP_SERVERS=1              # stop servers Arka started after use
# LLM_SERVER_START_TIMEOUT=15
# GEMINI_API_KEY is auto-mapped to GOOGLE_API_KEY for Agno Gemini


# =============================================================================
# NL routing & research
# =============================================================================
# ROUTE_MODE=symbolic                  # default: symbolic rules first, AI fallback
# ROUTE_MODE=ai                        # AI first, symbolic fallback
# ROUTE_MODE=symbolic_only             # offline rules only (no LLM routing)
# ROUTE_MODE=ai_only                   # LLM routing only (no symbolic rules)
# JUST_AI=1                            # plain LLM chat — skip routing, skills, and MCP tools

# NATIVE_LANG=hindi                    # survival/travel phrases (code may read ARKA_NATIVE_LANG in shell)

# RESEARCH_MIN_WORDS=500
# RESEARCH_MAX_WORDS=900
# RESEARCH_SCRAPE_MIN_WORDS=700        # deep research: min scraped web text
# RESEARCH_SCRAPE_PAGES=10             # deep research: max pages per query
# day_research: planner (topics + word budgets) vs executor (round prose + digest)
# SKILL_MODEL_DAY_RESEARCH_PLANNER=openrouter/anthropic/claude-sonnet-4   # strong planner
# SKILL_MODEL_DAY_RESEARCH_EXECUTOR=gemini/gemini-2.0-flash             # cheaper writer/aggregator
# BRIEF_URL_LIMIT_ENABLED=1            # daily/tech brief: 1 = excerpt under each headline, 0 = title+URL only
# BRIEF_URL_WORDS=30                   # words per excerpt when BRIEF_URL_LIMIT_ENABLED=1 (legacy: >0 also enables)
# MEMORY_SEARCH_FALLBACK=1             # if memory-only answer is unsure, search web (default on)
# MODEL_AWARE_SEARCH=1                 # trigger web search when query postdates active model cutoff (default on)
# MODEL_DEFAULT_CUTOFF=2023-01-01      # fallback cutoff for unknown models
# MODEL_CUTOFF_OVERRIDES={"groq/llama-3.1-8b-instant":"2023-12-01"}  # JSON map provider/model → YYYY-MM-DD


# =============================================================================
# Security (symbolic checks before web search, LLM calls, risky actions)
# =============================================================================
# SECURITY=1                           # master switch (default on)
# SECURITY_WEB=1                       # block prompt-injection in web/search queries
# SECURITY_LLM=1                       # verify prompts + sanitize context on LLM calls
# SECURITY_ACTIONS=1                   # confirm install/delete/send/download before run
# SECURITY_SANITIZE=1                  # strip injection patterns from untrusted LLM context
# EDIT_GUARD=1                         # block MCP/apply_patch edits to protected files (default on)
# EDIT_GUARD_MODE=enforce              # enforce|warn|off
# BLOCKED_EDIT_PATHS=recordings/**     # extra comma-separated globs to block
# ALLOWED_EDIT_PATHS=docs/**           # optional override allowlist
# User file: ~/.config/arka/blocked-edit-paths.txt (one glob per line)
# Project file: .arka/blocked-edit-paths (one glob per line)


# =============================================================================
# Agent identity & display
# =============================================================================
AGENT_NAME=arka
AGENT_WAKE_WORDS=hey arka,arka
# SHOW_MODEL=1                         # show provider/model under answers (default on; set 0 to hide)
# SHOW_CONTEXT7=1                      # show Context7 docs lookup in stderr + answer footer (default on)
# HUMAN_DOCS_BIAS=1                    # bias README/docs to files + human prose (default on)
# HUMAN_DOCS_BIAS_MODE=always          # always|auto|off — always inject compact rule into agent context
# CONTEXTUAL_ANSWER=1                  # add context + related-option comparisons (default on)
# CONTEXTUAL_ANSWER_MODE=auto          # auto|always|off — auto for explain/decision questions


# =============================================================================
# Autonomous goal agent (arka goal / loop — Butterfish Goal Mode style)
# =============================================================================
# GOAL_ENGINE=auto                     # auto|arka|butterfish|legacy|off (default: auto)
# GOAL_MAX_STEPS=25
# GOAL_TREE_DEPTH=3
# GOAL_AUTO_CONTINUE=1                 # auto-advance steps without prompting
# GOAL_OUTPUT_LIMIT=8000
# GOAL_SHELL_HISTORY=40                # fish history lines in goal context
# GOAL_CMD_TIMEOUT=300
# AUTO_INSTALL=1                       # skip install prompts (brew/go butterfish, etc.)


# =============================================================================
# Voice — wake listener & speech-to-text (run: arka listen)
# =============================================================================
# Wake listener is OFF by default unless AGENT_WAKE_AUTO=1
# AGENT_WAKE_AUTO=1                    # auto-start wake listener on shell open
# STT=auto                             # auto | assemblyai | groq | sarvam | vosk
# LISTEN_ENGINE=auto                   # auto | assemblyai | vosk
# LISTEN_DEBUG=0
# WAKE_REQUIRED=0                      # require wake word before every command
# ASSEMBLYAI_API_KEY=                  # https://www.assemblyai.com/dashboard/api-keys
# ASSEMBLYAI_REGION=us                 # us | eu | us-pinned (streaming host)
# ASSEMBLYAI_REALTIME_MODEL=universal-3-5-pro
# ASSEMBLYAI_SPEECH_MODELS=universal-3-pro,universal-2
# VOSK_TIER=medium                       # small | medium | best
# VOSK_PRESET=small-in                   # small-us | small-in | medium-us | best-in
# VOSK_MODEL=                            # custom model path
# VOSK_MODEL_URL=                        # custom model download URL
# MIC_DEVICE=                            # pactl list sources short (Linux) or CoreAudio name (macOS)
# PULSE_SOURCE=                          # alias for MIC_DEVICE
# COMMAND_SECONDS=10                     # seconds to capture command after wake word
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo


# =============================================================================
# Voice — text-to-speech & session
# =============================================================================
# AGENT_SPEAK=1                          # speak replies aloud (default on for listen)
# AGENT_SPEAK_MAX=900                    # chars read aloud per reply
# VOICE_SESSION_TURNS=8                  # follow-up context without re-waking
# AGENT_TTS=auto                         # auto | sarvam | edge | parler | system
# SPEAK_LANG=en-IN
# LISTEN_STT_LANG=en-IN                  # STT language (can differ from TTS)
# SARVAM_STT_MODE=translit               # transcribe | translit | verbatim | codemix
# SPEAK_VOICE=                           # edge-tts voice override
# SPEAK_GENDER=female                    # female | male (when voice not set)
# SPEAK_RATE=-5%                         # edge-tts rate (slightly slower = more natural)
# SPEAK_PITCH=+0Hz
# SPEAK_SPEAKER=                         # Indic Parler-TTS speaker override
# PARLER_MODEL=ai4bharat/indic-parler-tts

# Sarvam Bulbul v3 (optional cloud TTS — used when SARVAM_API_KEY is set)
# SARVAM_API_KEY=your_key_here
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_LANG=en-IN

# Indic Parler-TTS (default local voice when no Sarvam key)
# First time: arka tts-setup   then   arka speak-lang hi-IN
# Languages: en-IN hi-IN ta-IN te-IN bn-IN mr-IN gu-IN kn-IN ml-IN pa-IN or-IN as-IN ur-IN sa-IN


# =============================================================================
# Media — transcription, YouTube, batch QA
# =============================================================================
# MEDIA_STT=auto                         # alias: STT (see voice section)
# MEDIA_LANG=                            # defaults to SPEAK_LANG
# MEDIA_PYTHON=                          # Python for media subprocesses
# MEDIA_YOUTUBE=auto
# MEDIA_SUMMARY_CHUNK=12000
# STT_CHUNK_SECONDS=300
# LOCAL_FULL_MAX_SECONDS=1800
# LOCAL_WHISPER_MODEL=small
# HF_STT_MODEL=                          # HuggingFace STT model override
# LOCAL_WHISPER_DEVICE=                  # cuda | cpu
# LOCAL_WHISPER_COMPUTE=                 # float16 | int8
# FORCE_CPU=0
# STT_WORKERS=                           # parallel STT workers
# MEDIA_QA_CONTEXT=14000
# BATCH_MAX_ITEMS=25
# YT_RESEARCH_MAX=2
# YT_RESEARCH_POOL=
# YT_RESEARCH_DELAY=2
# YT_RESEARCH_ALLOW_NO_CAPTION=0
# YT_SKIP_TRANSCRIPT_API=0
# YT_TRANSCRIBE_FALLBACK=ask             # ask | yes | no — when captions missing, download + STT?
# YT_COOKIES_BROWSER=chrome              # helps fetch captions when API is blocked
# YOUTUBE_BULK_DOWNLOAD_DIR=~/Videos/YoutubeDownloads
# YOUTUBE_BULK_DIR=                      # optional external youtube_bulk_downloader app path
# ASK_YT_LIMIT=4
# SPEAK_RESEARCH_TIMEOUT=3600


# =============================================================================
# Session memory & long-term memory (OpenClaw-inspired layer)
# =============================================================================
# SESSION_MEMORY=1                       # markdown MEMORY.md + daily notes (~/.config/arka/agent-memory/)
# SESSION_MEMORY_DIR=                    # override memory root
# MEMORY_LONGTERM_MAX_LINES=100          # prune MEMORY.md wallet limit
# MEMORY_AUTO_LONGTERM=0                 # also append every note to MEMORY.md
# MEMORY=auto                            # auto | supermemory | local
# MEMORY_AUTODETECT=1                    # symbolic autodetect from NL chat/voice (default on)
# UNIFIED_MEMORY=1                       # route recall/remember through unified facade (default on)
# ARKA_MEMORY_TRUST_MAX=run              # cap recall/export: global | team | workflow | run (default run = all)
# ARKA_HUB_MEMORY_SCOPE=                 # hub export filter e.g. team:clawbox
# MEMORY_SCRATCHPAD_TTL_HOURS=72         # TTL for workflow scratchpad entries

# Supermemory (cloud long-term memory — API first, local cache fallback)
# Get key: https://supermemory.ai/docs/quickstart
# SUPERMEMORY_API_KEY=
# SUPERMEMORY_CONTAINER=arka             # container tag (defaults to AGENT_NAME)
# SUPERMEMORY_CONTAINER_TAG=             # alias for SUPERMEMORY_CONTAINER

# DataHub MCP Integration
# DATAHUB_GMS_URL=http://localhost:8080
# DATAHUB_GMS_TOKEN=


# =============================================================================
# Skills, professions & plugins
# =============================================================================
# SKILLS_PATH=~/my-arka-plugins          # extra skill dirs (colon-separated)
# SKILL_PERMISSIONS=read,write,network,shell
# PROFESSIONS_PATH=~/my-professions      # extra profession plugin dirs (colon-separated)
# PROFESSION_EXAMPLES=0                  # load bundled example professions (dev/demo)
# PROFESSIONS_ROOT=~/Projects/professions
# STOCK_PROJECT=~/Projects/professions/investor/stock_analyzer
# PROFESSION_STARTUP_PROJECT=~/Projects/my-startup
# PROFESSION_DOCTOR_PROJECT=~/Projects/clinic-app
# PROFESSION_NUTRITIONIST_PROJECT=~/Projects/nutrition-coach
# PROFESSION_PROJECTS={"startup":"~/Projects/my-startup"}   # JSON map (legacy: ARKA_PROFESSION_PROJECTS)
# Install: arka skills install /path   |   profession install /path


# =============================================================================
# Routines, reminders & usage tracking
# =============================================================================
# AUTO_START=1                           # start remote server on shell open (not listen unless AGENT_WAKE_AUTO=1)
# USAGE_TRACK=1                          # track app + website time (starts on login)
# WEB_TRACK=1                            # website/domain tracking (Brave, Chrome, Firefox)
# USAGE_INTERVAL=20
# USAGE_IDLE_SEC=120
# ACTIVITYWATCH_URL=http://127.0.0.1:5600

# ROUTINES_SECURITY=1                    # block risky actions in cron (non-interactive)
# ROUTINES_MORNING=09:00
# ROUTINES_EVENING=18:00
# ROUTINES_DAILY=09:00
# ROUTINES_AUTO_INSTALL=0

# REMIND_DEFAULT=1h                      # when no time given: "remind to …"
# REMIND_TICK_SEC=30
# REMIND_GAP_SEC=120
# REMIND_IDLE_SEC=300                    # idle threshold — also remind when you return
# REMIND_ACTIVE_SEC=60                   # keyboard/mouse within N sec = "using PC"
# REMIND_SPEAK=0                         # 1 = speak reminder aloud

# Email alerts (selections, credits, hackathon/study deadlines)
# ALERT_EMAIL_TO=you@example.com           # recipient for cross-platform email alerts
# ALERT_EMAIL_FROM=alerts@yourdomain.com   # sender (Resend/SendGrid/SMTP)
# ALERT_EMAIL_ENABLED=1                    # 0 = OS notifications only
# ALERT_AUTO=1                             # 1 = auto-detect common events (default on); 0 = manual only
# ARKA_ALERT_MODEL_EXHAUSTED=1             # 1 = alert when preferred LLM failover chain is exhausted
#                                          # or: arka alert model-exhausted on
# LLM_EXHAUSTION_NOTIFY=1                 # legacy OS-only notify when all models fail (if alert off)
# LLM_EXHAUSTION_COOLDOWN=3600             # dedupe window for model-exhaustion alerts (seconds)
# RESEND_API_KEY=                          # preferred transactional email provider
# SENDGRID_API_KEY=                        # alternative transactional email provider
# SMTP_HOST=                               # fallback SMTP relay
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1


# =============================================================================
# Network — outbound proxy / VPN (optional)
# =============================================================================
# Standard vars (curl, Python urllib, httpx, requests):
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1,.local
#
# Arka aliases (ARKA_* keys normalize on load):
# ARKA_PROXY=http://127.0.0.1:7890       # → PROXY; applied to HTTP/HTTPS when unset
# ARKA_NO_PROXY=localhost,127.0.0.1      # → NO_PROXY
# ARKA_PROXY_ENABLED=1                   # → PROXY_ENABLED; 0 disables apply_proxy_env
# ARKA_VPN_PROXY=http://127.0.0.1:7890   # → VPN_PROXY; used when a VPN interface is up
# ARKA_VPN_INTERFACE=utun4               # → VPN_INTERFACE; extra interface to treat as VPN
#
# CLI: arka proxy status | test | on | off | rotate | list | use <index|url>
#
# Proxy pool / rotation (optional):
# ARKA_PROXY_LIST=http://127.0.0.1:7890,http://127.0.0.1:7891,socks5://127.0.0.1:1080
# ARKA_PROXY_LIST_FILE=~/.config/arka/proxies.txt   # one URL per line or JSON array
# ARKA_PROXY_ROTATION=round-robin                   # round-robin | random | sticky
# ARKA_PROXY_ROTATE_ON_FAIL=1                       # auto-advance pool when proxy test fails


# =============================================================================
# Unified API — one URL + token for agent server, bridges, CLI, n8n, web UI
# =============================================================================
# Set these two and Arka mirrors them to legacy keys (REMOTE_URL, REMOTE_TOKEN, …).
# Short names preferred; ARKA_API_URL / ARKA_API_TOKEN also work (normalize on load).
#
# API_URL=http://127.0.0.1:8765          # agent server base (from `arka serve`)
# API_TOKEN=                              # Bearer for POST /v1/agent — auto-generated on first serve
# OpenAI-compatible (ChatGPT-style) on the same server:
#   GET  /v1/models
#   POST /v1/chat/completions            # full Arka agent + skills (stream supported)
# REMOTE_TIMEOUT=600                      # optional HTTP timeout (seconds)
#
# Legacy aliases still supported if you already use them:
# BACKEND_URL=  BACKEND_TOKEN=  REMOTE_URL=  REMOTE_TOKEN=
# REMOTE_HOST=127.0.0.1  REMOTE_PORT=8765   # used when API_URL is unset


# =============================================================================
# Remote server, webhooks & phone bridge
# =============================================================================
# REMOTE_HOST=127.0.0.1                # default local-only; use 0.0.0.0 on Railway (PORT set) or LAN with API_TOKEN
# REMOTE_PORT=8765
# REMOTE_TOKEN=                          # legacy — prefer API_TOKEN (mirrored automatically)
# REMOTE_URL=http://192.168.1.5:8765     # legacy — prefer API_URL
# REMOTE_TIMEOUT=600

# WEBHOOK_ENABLED=0                      # opt-in verified ingress for external channels
# WEBHOOK_TOKEN=                         # required when enabled (falls back to REMOTE_TOKEN)
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=8767
# WEBHOOK_MAX_CHARS=4000
# WEBHOOK_TIMEOUT=300

# Arka API — inference-only HTTP server (no MCP/tools/skills)
# ARKA_API_ENABLED=0
# ARKA_API_HOST=127.0.0.1                 # default localhost; reverse-proxy for remote access
# ARKA_API_PORT=8768
# ARKA_API_TOKEN=                          # legacy — prefer API_TOKEN (mirrored automatically)
# ARKA_API_RPM=60                          # per-IP rate limit (requests/minute)
# ARKA_FETCH_DEDUP=1                       # coalesce duplicate fetches (env, model lists, web search, arka-api chat)
# ARKA_API_ONLY=1                          # LLM chat only — disable tools/skills

# Channel sessions + sub-agent delegation (canonical: MESSAGE_SESSION_* / SUBAGENT_*)
# Legacy HERMES_* aliases still work.
# MESSAGE_SESSIONS=1                      # per-channel message session store
# MESSAGE_SESSIONS_DIR=                   # override (~/.config/arka/message-sessions/)
# MESSAGE_SESSION_IDLE_MINUTES=0          # auto-reset after idle (0 = never)
# MESSAGE_SESSION_MAX_TURNS=40
# MESSAGE_SESSION_CHANNEL=cli             # default CLI channel key
# MESSAGE_SESSION_CHAT_ID=default         # default CLI chat id
# CHAT_CONTEXT_GATE=heuristic             # heuristic (default) | llm | off — past-chat gate for web UI
# WEB_CHAT_FAST=1                         # 1 = fast models, skip graph recall + extra LLM retries
# ARKA_DEV_FAQ_CACHE=1                    # instant answers for common dev questions (default on)
# ARKA_DEV_FAQ_CACHE_TTL=604800           # learned dev FAQ TTL seconds (7 days); builtins never expire
# WEBUI_CHAT_ID_FALLBACK=1                 # hash first user message when X-OpenWebUI-Chat-Id missing

# Agent Hub — shared MCP/memory/skills for ollama launch agents
# ARKA_HUB_DIR=~/.config/arka/hub         # hub root (default)
# ARKA_MCP_CONFIG=                        # override hub MCP path passed to agents
# ARKA_MEMORY_DIR=                        # override hub memory export directory
# AGENT_HUB_SYNC_ON_LAUNCH=1              # sync hub before agent_hub launch (default on)
# ARKA_CONFIG_BACKUP_ON_UNIFY=1           # backup config before agent_hub sync --unify
# Arka self-MCP: arka mcp serve  |  arka mcp install  (Cursor/Claude mcp.json snippet)
# Context7 MCP (library docs): configured by `arka setup` — npx @upstash/context7-mcp
# CONTEXT7_API_KEY=ctx7sk-...          # from `npx ctx7 setup` or https://context7.com
# SERPER_API_KEY=                       # optional web search provider
# TAVILY_API_KEY=                       # optional web search provider
# BRAVE_SEARCH_API_KEY=                 # optional web search provider

# Agent Teams — cross-agent/model/provider workflows
# ARKA_TEAMS_DIR=~/.config/arka/teams     # team definitions (default)
# ARKA_WORKFLOWS_DIR=~/.config/arka/workflows
# TEAM_MAX_PARALLEL=4                     # max parallel workflow steps
# TEAM_RETRY_BACKOFF=0                    # exponential retry delay (1=on)
# TEAM_MCP_TOOL_ROUNDS=0                  # MCP tool loop rounds for model steps
# SUBAGENT_ENABLED=1                      # background sub-agent delegation
# SUBAGENT_DIR=                           # override (~/.cache/fish-agent/subagents/)
# SUBAGENT_MAX=3                          # max concurrent background agents
# SUBAGENT_TIMEOUT=600
# SUBAGENT_SECURITY=1                     # apply SECURITY_LLM gates to spawn tasks
# SUBAGENT_MAX_CHARS=4000

# HF_BRIDGE_HOST=127.0.0.1               # HuggingFace inference bridge
# HF_BRIDGE_PORT=8787
# HF_BRIDGE_TIMEOUT=180

# Usage dashboard — local skill/MCP stats (arka dashboard)
# ARKA_DASHBOARD_HOST=127.0.0.1
# ARKA_DASHBOARD_PORT=8788

# Open WebUI launcher branding (local <50-user deployments)
# ARKA_OPEN_WEBUI_NAME=Arka
# ARKA_OPEN_WEBUI_KEEP_SUFFIX=0          # 1 = show "Arka (Open WebUI)"
# ARKA_OPEN_WEBUI_BRANDING_DIR=          # override web/open-webui/branding

# WhatsApp inbox (optional)
# WHATSAPP_FROM=+1234567890
# WHATSAPP_REPLY=1
# WHATSAPP_REPLY_MAX=1500
# WHATSAPP_POLL=5
# WHATSAPP_DEBUG=0


