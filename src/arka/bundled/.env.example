# =============================================================================
# Info / YouTube video composer (compose_video — stock photos + charts + ffmpeg)
# =============================================================================
# Photo sources (at least one key for B-roll; chart scenes use B-roll after chart hold):
# VIDEO_PHOTO_SOURCES=unsplash,pexels,pixabay,openverse,web,brightdata
# VIDEO_VIDEO_SOURCES=pexels,pixabay,brightdata
# Openverse and web image search need no API key.
# Bright Data fallback (when primary sources fail or return no matches):
# BRIGHTDATA_API_TOKEN=                   # https://brightdata.com/cp/setting/users
# BRIGHTDATA_SERP_ZONE=serp_api           # optional SERP zone name
# VIDEO_STOCK_FALLBACK=brightdata         # set none to disable Bright Data fallback
# BRIGHTDATA_RATE_LIMIT_SEC=0.5           # min delay between Bright Data requests
# BRIGHTDATA_SEARCH_GEO=us                # default geo_location for search_engine (us, uk, in, …)
# BRIGHTDATA_SEARCH_ENGINE=google         # google | bing | yandex
# ARKA_WEB_SEARCH=auto                    # auto | brightdata | duckduckgo
# UNSPLASH_ACCESS_KEY=                   # https://unsplash.com/developers
# PEXELS_API_KEY=                        # https://www.pexels.com/api/
# PIXABAY_API_KEY=                       # https://pixabay.com/api/docs/
# VIDEO_CHART_SEC=15                     # bar/chart hold time before B-roll continues
# VIDEO_MAX_CAPTION_BEATS=6
# VIDEO_OUTPUT_DIR=~/Videos/arka-generated
# VIDEO_SHOW_LABELS=1                  # burn story-beat labels (intro, conflict, …) on scenes
# VIDEO_AUTO_FILL=1                    # AI-generate images when stock search misses (compose_story)
# VIDEO_FONT=Inter
# VIDEO_FONT_BOLD=Inter-Bold
# VIDEO_FONT_PATH=/path/to/Regular.ttf
# VIDEO_FONT_BOLD_PATH=/path/to/Bold.ttf
