# VIDEO_BODY_FONT_SIZE=42
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# VIDEO_FPS=30
# VIDEO_SCENE_SEC=5
# VIDEO_CRF=18                           # lower = higher quality (15–23 typical)
# VIDEO_PRESET=medium                    # ultrafast|fast|medium|slow
# VIDEO_BG_COLOR=#0f172a
# VIDEO_TEXT_COLOR=#f8fafc
# VIDEO_ACCENT_COLOR=#38bdf8
# VIDEO_TTS=edge                         # edge | none
# VIDEO_TTS_VOICE=en-US-GuyNeural
# VIDEO_COMPOSE_SCRIPT=auto              # auto | llm | template
# VIDEO_MODE=hybrid                      # hybrid | photos | video | auto (hybrid default)
# VIDEO_BURN_TEXT=0                      # 1 restores on-screen titles/captions
# VIDEO_NO_TEXT=1                        # force no burned-in text
# VIDEO_USE_STOCK_VIDEO=1                # legacy alias for VIDEO_MODE=video
# VIDEO_SCRIPT_PROVIDER=auto             # auto | builtin | llm | custom
# VIDEO_SCRIPT_API_URL=                  # POST endpoint for custom scene JSON
# VIDEO_SCRIPT_API_KEY=                  # optional bearer token for custom API
# VIDEO_SCRIPT_API_KEY_ENV=VIDEO_SCRIPT_API_KEY
