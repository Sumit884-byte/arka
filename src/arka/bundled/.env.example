# =============================================================================
# SPOTIPY_CLIENT_ID=                     # free Developer Dashboard app
# SPOTIPY_CLIENT_SECRET=
# Or: SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET
# SPOTIPY_CDP_URL=                       # Chrome DevTools for DOM control (Linux)
# macOS: Spotify.app — playback via AppleScript (no API key for playback)
# Linux: spotify desktop + playerctl for auto-play

# X/Twitter — post_x skill (shorten URL + tweet)
# Option A — Twitter API v2 (developer portal OAuth 1.0a user tokens):
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# Aliases: X_API_KEY, X_API_SECRET, X_ACCESS_TOKEN, X_ACCESS_TOKEN_SECRET
# Option B — bird CLI (auto-installs @steipete/bird on first post_x when Node/npm present):
# X_AUTH_TOKEN=                        # from x.com cookie auth_token
# X_CT0=                               # from x.com cookie ct0
# BIRD_CLI=/path/to/bird               # optional override (skip auto-install)
# POST_X_DEFAULT_WORDS=40              # default shorten limit for post_x
# Manual install: post_x install       # or npm install -g @steipete/bird

# dev.to — post_devto skill (write/publish articles)
# DEVTO_API_KEY=                       # from dev.to/settings/extensions
# integration setup devto --key YOUR_KEY

# VAULT_KEY=                             # encrypt password vault at rest
# SPORTS_DEFAULT=cricket                 # default sport for scores
# DISK_CSV=                              # disk usage report output path
# NO_PROGRESS=0                          # disable progress bars
# PROGRESS=1
# HEARTBEAT: arka heartbeat status  |  arka session-memory status
# CHANNELS: message_session status  |  subagent status


# =============================================================================
# Model optimization: auto|performance|balanced|cheap|offline
# ARKA_PRODUCTION_MODE=1                 # require production safeguards by default
# ARKA_DATA_MODE=schema                   # schema|full; minimize trade-secret payloads sent to models
# ARKA_EDGE_MODE=0                        # constrained-device profile
# ARKA_EDGE_MODEL=llama3.2:1b             # compact local model override
# ARKA_MODEL_MODE=auto
# ARKA_PREFERRED_SMALL_MODEL=llama3.2:3b
# ARKA_PREFERRED_CODING_MODEL=qwen2.5-coder:7b
# ARKA_MAX_CONTEXT=auto
# ARKA_QUANT=4bit

# OpenTelemetry / SigNoz — AI & agent observability (default ON → local :4318)
# =============================================================================
# OTEL_SDK_DISABLED=true           # master kill switch — disables all OTLP export
# OTEL_TRACES_ENABLED=0            # opt out of traces (metrics/logs follow traces)
# OTEL_METRICS_ENABLED=0           # opt out of metrics while traces stay on
# OTEL_LOGS_ENABLED=0              # opt out of logs while traces stay on
# OTEL_SERVICE_NAME=arka
# OTEL_SERVICE_NAMESPACE=arka-agent
# SIGNOZ_ENDPOINT=http://localhost:4318   # default OTLP base when unset
# SIGNOZ_UI_URL=http://localhost:8080
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_TIMEOUT=2     # seconds — short timeout avoids export retry spam
# OTEL_SKIP_ENDPOINT_PROBE=1       # skip TCP probe (start export even if collector is down)
# Inspect: arka signoz status  |  arka signoz demo  |  python3 bin/arka_llm.py trace-status
# Model coordination: local-first, hosted-first, parallel, local-only, hosted-only
ARKA_MODEL_POLICY=local-first
# Automatically improve user-authored prompts locally (set 0 to disable)
ARKA_PROMPT_OPTIMIZE=1
# Opt-in chunking for oversized prompts (one final synthesis request).
ARKA_PROMPT_CHUNKING=0
ARKA_PROMPT_CHUNK_SIZE=12000
