{
  "name": "music_generate",
  "description": "Generate original music with Pollinations (elevenmusic) or a local ffmpeg tone-synthesis fallback when no API key is configured",
  "version": "1.0.0",
  "author": "Arka",
  "type": "python",
  "entry": "run.py",
  "triggers": [
    "generate music",
    "create music",
    "make music",
    "compose music",
    "create a song",
    "generate a song",
    "make a song",
    "compose a song",
    "create a track",
    "generate a beat"
  ],
  "permissions": ["read", "write", "network", "shell"],
  "requires": {
    "env": ["POLLINATIONS_API_KEY"],
    "env_optional": ["MUSIC_BACKEND", "MUSIC_MODEL", "MUSIC_DURATION"],
    "bins": ["ffmpeg"]
  }
}
